SOLVER CVODE
STARTING_TIME 0.0
ENDING_TIME 2.0
RELATIVE_TOLERANCE 1.0E-9
ABSOLUTE_TOLERANCE 1.0E-9
MAX_TIME_STEP 0.1
KEEP_EVERY 1
DISCONTINUITIES 2
__D_B_0 (t > 0.1); (-0.1 + t);
__D_B_1 (t > 0.2); (-0.2 + t);
EVENTS 2
EVENT late
TRIGGER (__D_B_0 == 1.0);
DELAY false 1.0;
EVENTASSIGNMENTS 1
1 1.0;
EVENT early
TRIGGER (__D_B_1 == 1.0);
DELAY false 0.3;
EVENTASSIGNMENTS 1
2 1.0;
NUM_EQUATIONS 3
ODE x INIT 0.0;
	 RATE 1.0;
ODE y INIT 0.0;
	 RATE 0.0;
ODE z INIT 0.0;
	 RATE 0.0;
