end_highResVolumeSamples

# geometry
dim 3
max_compartment 1

# boundaries
low_wall 0 0.0 r
high_wall 0 2.0 r
low_wall 1 0.0 r
high_wall 1 2.0 r
low_wall 2 0.0 r
high_wall 2 1.0 r

# compartments
start_compartment cell
point 1.0 1.75 0.75
end_compartment

# drift properties
drift A 0.0 0.0 0.0

# reactions
reaction convert A -> 0 1.0;

# molecules
max_mol 50000
compartment_mol 196 A cell

# simulation times
time_start 0.0
time_stop 0.2
time_step 0.02

# killmolincmpt runtime command to kill molecules misplaced during initial condtions

# kill membrane molecues that are absorbed (to nothing)

# runtime command
cmd E vcellPrintProgress
output_files SimID_1000_0_.smoldynOutput
cmd N 5 incrementfile SimID_1000_0_.smoldynOutput
cmd N 5 listmols SimID_1000_0_.smoldynOutput
cmd B vcellDataProcess begin RoiTimeSeries
cmd B vcellDataProcess end
cmd N 5 vcellWriteOutput begin
cmd N 5 vcellWriteOutput dimension 3
cmd N 5 vcellWriteOutput sampleSize 9 9 5
cmd N 5 vcellWriteOutput numMembraneElements 0
cmd N 5 vcellWriteOutput variable A volume cell
cmd N 5 vcellWriteOutput end

# simulation settings
accuracy 10.0
gauss_table_size 4096

end_file
