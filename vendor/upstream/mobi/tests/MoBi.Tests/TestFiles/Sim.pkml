              <Parameter id="OY-oUAet9kmlfqegoIjoOw" name="Fraction unbound (plasma, reference value)" description="Fraction unbound in plasma of the reference individual, i.e. in the case of human typically an average healthy adult. This reference value can be scaled to children based on the ontogeny of the respective plasma protein and/or in diseased subjects using the plasma protein scale factor defined in the individual" icon="Parameter" persistable="0" isFixedValue="0" dim="Fraction" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Property" isDefault="1" value="NaN">
