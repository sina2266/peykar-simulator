            <Formula id="F2u5zuvYgE-VYDQoP6l1yQ" name="PARAM_fu" dim="Fraction" formula="1 / (1 + (BindingPartner = Albumin ? AlbuminOntgenyFactor : (BindingPartner = Agp ? AgpOntogenyFactor : 1) ) * (1 - fu_ref) / fu_ref) * PlasmaProteinScaleFactor">
