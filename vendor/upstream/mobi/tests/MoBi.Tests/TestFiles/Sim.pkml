        <CoreCalculationMethod name="Cellular partition coefficient method - PK-Sim Standard" icon="CoreCalculationMethod" bbVersion="0" category="DistributionCellular">
          <Creation createdAt="5248777804433062044" createdBy="Michael" creationMode="New" origin="Other" />
          <OutputFormulas>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - PK-Sim Standard.PARAM_K_rbc" name="PARAM_K_rbc" formula="(f_water_rbc + f_lipids_rbc * 10^LogMA + f_proteins_rbc * KProt)*fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" dim="5" />
                  <Path path="6" as="7" />
                  <Path path="8" as="9" />
                  <Path path="10" as="11" />
                  <Path path="12" as="13" />
