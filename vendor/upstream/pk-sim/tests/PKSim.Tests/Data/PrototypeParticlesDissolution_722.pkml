              <Formula id="hbsZOy-QPUCFKveskW7fHQ" name="PARAM_Ka_AP" formula="Max(0;Kpu_bc - (1+Z)/(1+Y)*f_iw_bc - (10^LogP*f_nl_bc + (0.3*10^LogP+0.7)*f_np_bc)/(1+Y)) * (1+Y) / AP_bc / Z">
