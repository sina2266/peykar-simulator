 "model": {
  "id": "cornea.endothelial-density-population",
  "version": "1.0.0",
  "kinetics": "f(t) = (1 - A) (1 + t/tau)^(-p), t in months, f = ECD / reference ECD",
  "parameters": "theta = (ln(1-A), ln tau, ln p) on a fixed grid: ln(1-A) 201 points over [ln 0.05, 0], tau 40 log-spaced points 0.01..36 months, p 30 log-spaced points 0.002..1",
  "observation": "Gaussian noise in ln f; SD per (study, tissue family, series kind) from best grid fits of series with >=4 follow-ups; a new study's SD marginalized over log-normal(log-SD 0.5) around the family/kind median",
  "hierarchy": "per tissue family (species x host/graft endothelium): family mean, context effect (species/procedure; recipient-referenced grafts separate), study effect, series deviation (group mean or single eye); diagonal covariances by penalized REML (Gamma(2) SD modes 0.1, 0.5, 0.5) on flat-prior grid posterior moments; context means by exact BLUP",
  "fallback": "a context absent from training uses its tissue family mean with the context variance added; a family with <2 training studies has no population prior",
  "forecasting": "population_anchored_t4: Student-t(4) population prior, unknown constant log offset per series with flat prior (shape-only likelihood), forecasts anchored to the prefix level",
  "development_changes_before_freeze": [
   "round 0 (5 development studies, smoke): exponential acute phase + constant chronic rate; linear-A grid gave a single-eye prior too narrow for graft eyes after phakic-IOL decompensation, logit-A grid gave volume-driven noise inflation; adopted ln(1-A) grid, per-family fits, family/kind noise centres and noise log-SD 0.5 (was 1.0)",
   "anchored (offset-marginalized) forecasts and a robust 0.2 uniform-mixture prior added after the smoke test; a shape-only population fit was tried on 5 studies and discarded (prior dominated by grid volume)",
   "round 1 full LOSO (exponential law): anchored_t4 next-observation pooled RMSE 4.53 pp, graft forecasts biased (+3.2 pp DMEK)",
   "power-law kinetics adopted after an in-sample comparison on development series with >=4 follow-ups (graft dof-adjusted log-SD 0.078 vs 0.093, host equal)",
   "round 2 full LOSO (power law): anchored_t4 next-observation pooled RMSE 4.01 pp, landmark 5.45 pp",
   "author-overlap rule (>=2 shared Europe PMC author names) declared after round 2: linked development studies leave training together; round 3 is the reference development run"
  ]
 },
