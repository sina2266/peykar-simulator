 "status": "frozen before any tranche-2 outcome value was read by the model developer",
 "context_of_use": [
  "U1 initial-state prediction of a new study's control-group mean intraocular pressure (fraction of its preoperative IOP) after a glaucoma procedure in human eyes, from procedure, series kind, number of eyes and the preoperative IOP only",
  "U2 causal forecasting of each human group mean's next follow-up (control and treated groups) from its own earlier follow-ups",
  "U3 landmark forecasting of every later follow-up of each human group mean from its first postoperative measurement only"
 ],
 "not_claimed": [
  "biological mechanism validation (aqueous production and outflow are not modelled)",
  "single-eye prediction (reported only)",
  "non-human species (no training study; the tranche-2 rabbit record gets no population prior)",
  "series without a preoperative IOP value (percent-change series without a reference get no population prior and drop out of the paired comparisons)",
  "treatment-effect prediction (treated groups use the control prior of their context)",
  "surgical success or failure, hypotony or spike events, medication-adjusted pressure, tonometer equivalence, clinical decision use"
 ],
 "model": {
  "id": "eye.iop-population",
  "version": "1.1.0",
  "kinetics": "ln f(t) = ell + e r(t) + s q(t), r = exp(-(t - t1)/tau), q = exp(-(t - t1)/tq), t1 = 1 day, tq = 7 days fixed, t in months, f = IOP / preoperative IOP; ell = context level + b ln(IOP0 / 20 mmHg)",
  "noise": "Gaussian in ln f; group-mean SD scaled by (n/40)^-g with g estimated in each fit from study noise estimates (series with >=5 follow-ups), clipped to [0, 0.5]; a new study's SD marginalized over log-normal(log-SD 0.5) around the scaled median, floor 0.01",
  "hierarchy": "one hierarchy per species: species mean of (ell, e, s, ln tau), shared level slope b as a fixed effect by GLS inside REML, procedure context, study and series deviations (group means and single eyes separately); diagonal covariances by penalized REML (Gamma(2) SD modes 0.1, 0.1, 0.1, 0.5) on per-series likelihood-information summaries",
  "computation": "exact Gaussian mixtures over an 80-point tau grid 0.01..120 months, noise levels, Student-t nodes and robust components; quantiles from the exact mixture CDF; point forecast = predictive median",
  "fallback": "a procedure without training studies uses the species mean with the context variance added"
 },
 "methods": {
  "primary_U1": "population_initial_state",
  "primary_U2": "population_assimilation",
  "primary_U3": "population_assimilation",
  "secondary": "the other population variants, weak_prior, analog_knn (k=5), pooled_curve_ratio, last_two_log_linear, reference_to_last_log_linear, preoperative_level, persistence; the frozen model 1.0.0 (Gaussian prior variant, its group-mean selection) as the H5 reference",
  "selection_rule": "declared before round 1 of 1.1: lowest pooled group-mean next-observation RMSE among the five population variants with group-mean coverage inside both windows; ties within 0.05 pp to the simpler variant"
 },
 "training": "all 72 tranche-1 records (47 development, 25 consumed 1.0.0 sealed; 169 series); controls with a preoperative IOP fit the population, all series give noise and analog-library inputs; for each sealed study the training studies linked to it by the author-overlap rule are removed from its training set",
