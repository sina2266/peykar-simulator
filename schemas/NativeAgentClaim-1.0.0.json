{
  "$defs": {
    "NativeExecutionProfile": {
      "additionalProperties": false,
      "properties": {
        "driver_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Driver Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "copasi_sbml",
            "osp_pkml"
          ],
          "title": "Kind",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "runtime": {
          "$ref": "#/$defs/Reference"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "runtime",
        "driver_digest",
        "limitations"
      ],
      "title": "NativeExecutionProfile",
      "type": "object"
    },
    "NativeModelInspection": {
      "additionalProperties": false,
      "properties": {
        "compartment_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Compartment Units",
          "type": "object"
        },
        "model_time_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Time Unit"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "parameter_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Parameter Units",
          "type": "object"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Species Units",
          "type": "object"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "root",
        "namespace"
      ],
      "title": "NativeModelInspection",
      "type": "object"
    },
    "NativeModelPackage": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "inspection": {
          "$ref": "#/$defs/NativeModelInspection"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_validity": {
          "const": "not_established",
          "default": "not_established",
          "title": "Scientific Validity",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/NativeModelSpec"
        }
      },
      "required": [
        "spec",
        "content_digest",
        "inspection"
      ],
      "title": "NativeModelPackage",
      "type": "object"
    },
    "NativeModelSpec": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ScientificContext"
        },
        "format": {
          "enum": [
            "sbml",
            "pkml"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "license": {
          "maxLength": 500,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "format",
        "context",
        "license",
        "source",
        "limitations"
      ],
      "title": "NativeModelSpec",
      "type": "object"
    },
    "NativeRunManifest": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "model_snapshot": {
          "$ref": "#/$defs/NativeModelPackage"
        },
        "plan": {
          "$ref": "#/$defs/NativeRunSpec"
        },
        "profile_snapshot": {
          "$ref": "#/$defs/NativeExecutionProfile"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "runtime_snapshot": {
          "$ref": "#/$defs/NativeRuntimeEvidence"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "plan",
        "model_snapshot",
        "profile_snapshot",
        "runtime_snapshot"
      ],
      "title": "NativeRunManifest",
      "type": "object"
    },
    "NativeRunSpec": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intervals": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intervals"
        },
        "model": {
          "$ref": "#/$defs/Reference"
        },
        "profile": {
          "$ref": "#/$defs/Reference"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "wall_seconds": {
          "default": 180.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "model",
        "profile"
      ],
      "title": "NativeRunSpec",
      "type": "object"
    },
    "NativeRuntimeEvidence": {
      "additionalProperties": false,
      "description": "An operator's retained execution evidence; never an executable API request.",
      "properties": {
        "artifact_digests": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxProperties": 2000,
          "minProperties": 1,
          "title": "Artifact Digests",
          "type": "object"
        },
        "engine": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Engine",
          "type": "string"
        },
        "execution_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Execution Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "managed_queue_supported": {
          "const": false,
          "default": false,
          "title": "Managed Queue Supported",
          "type": "boolean"
        },
        "profile": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Profile",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_validity": {
          "const": "not_established",
          "default": "not_established",
          "title": "Scientific Validity",
          "type": "string"
        },
        "scope": {
          "const": "operator_native_probe",
          "default": "operator_native_probe",
          "title": "Scope",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "engine",
        "profile",
        "sources",
        "image_digest",
        "execution_digest",
        "artifact_digests",
        "limitations"
      ],
      "title": "NativeRuntimeEvidence",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    },
    "ScientificContext": {
      "additionalProperties": false,
      "properties": {
        "biological_system": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Biological System",
          "type": "string"
        },
        "conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Species",
          "type": "string"
        }
      },
      "required": [
        "species",
        "biological_system"
      ],
      "title": "ScientificContext",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:NativeAgentClaim:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "#/$defs/NativeRunManifest"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "token": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Token",
      "type": "string"
    }
  },
  "required": [
    "manifest",
    "token"
  ],
  "title": "NativeAgentClaim",
  "type": "object"
}
