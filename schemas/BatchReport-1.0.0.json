{
  "$defs": {
    "BatchGroupSummary": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Case Id",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/EndpointStatistics"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "excluded_member_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Excluded Member Ids",
          "type": "array"
        },
        "expected_replicates": {
          "title": "Expected Replicates",
          "type": "integer"
        },
        "grid_index": {
          "title": "Grid Index",
          "type": "integer"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterValue"
          },
          "title": "Parameters",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "successful_replicates": {
          "title": "Successful Replicates",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "grid_index",
        "parameters",
        "expected_replicates",
        "successful_replicates",
        "excluded_member_ids",
        "complete",
        "endpoints"
      ],
      "title": "BatchGroupSummary",
      "type": "object"
    },
    "BatchMemberEvidence": {
      "additionalProperties": false,
      "properties": {
        "manifest_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manifest Digest"
        },
        "member_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Member Id",
          "type": "string"
        },
        "queue": {
          "enum": [
            "reference",
            "native"
          ],
          "title": "Queue",
          "type": "string"
        },
        "result_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Digest"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "member_id",
        "queue",
        "run_id",
        "status",
        "manifest_digest",
        "result_digest"
      ],
      "title": "BatchMemberEvidence",
      "type": "object"
    },
    "BatchMemberRecord": {
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Member Id",
          "type": "string"
        },
        "queue": {
          "enum": [
            "reference",
            "native"
          ],
          "title": "Queue",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "skipped",
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "member_id",
        "queue",
        "run_id",
        "status"
      ],
      "title": "BatchMemberRecord",
      "type": "object"
    },
    "BatchRunRecord": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "$ref": "#/$defs/Reference"
        },
        "batch_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Batch Digest",
          "type": "string"
        },
        "cancel_requested": {
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/BatchMemberRecord"
          },
          "title": "Members",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "batch",
        "batch_digest",
        "status",
        "cancel_requested",
        "error",
        "created_at",
        "updated_at",
        "members"
      ],
      "title": "BatchRunRecord",
      "type": "object"
    },
    "EndpointStatistics": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "sample_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Standard Deviation"
        },
        "samples": {
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "output",
        "unit",
        "samples",
        "mean",
        "minimum",
        "maximum",
        "sample_standard_deviation"
      ],
      "title": "EndpointStatistics",
      "type": "object"
    },
    "ParameterValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "quantity"
      ],
      "title": "ParameterValue",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "$id": "urn:peykar:schema:BatchReport:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "groups": {
      "items": {
        "$ref": "#/$defs/BatchGroupSummary"
      },
      "title": "Groups",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/BatchMemberEvidence"
      },
      "title": "Members",
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/BatchRunRecord"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_validity": {
      "const": "not_established",
      "default": "not_established",
      "title": "Scientific Validity",
      "type": "string"
    },
    "uncertainty_scope": {
      "const": "within_case_terminal_sample_variability",
      "default": "within_case_terminal_sample_variability",
      "title": "Uncertainty Scope",
      "type": "string"
    }
  },
  "required": [
    "run",
    "groups",
    "members",
    "limitations"
  ],
  "title": "BatchReport",
  "type": "object"
}
