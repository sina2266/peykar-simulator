{
  "$defs": {
    "ExperimentNodeRecord": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Node Id",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "status"
      ],
      "title": "ExperimentNodeRecord",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "$id": "urn:peykar:schema:ExperimentRunRecord:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cancel_requested": {
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "experiment": {
      "$ref": "#/$defs/Reference"
    },
    "experiment_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Experiment Digest",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/ExperimentNodeRecord"
      },
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "experiment",
    "experiment_digest",
    "status",
    "cancel_requested",
    "created_at",
    "updated_at",
    "nodes"
  ],
  "title": "ExperimentRunRecord",
  "type": "object"
}
