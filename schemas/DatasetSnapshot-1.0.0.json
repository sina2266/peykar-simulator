{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:DatasetSnapshot:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "independence_group": {
      "title": "Independence Group",
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/Reference"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Spec Digest",
      "type": "string"
    }
  },
  "required": [
    "reference",
    "spec_digest",
    "artifact_digest",
    "independence_group"
  ],
  "title": "DatasetSnapshot",
  "type": "object"
}
