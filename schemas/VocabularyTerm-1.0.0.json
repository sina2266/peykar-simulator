    "xrefs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 2000,
      "title": "Xrefs",
      "type": "array"
    }
  },
  "required": [
    "id",
    "label"
  ],
  "title": "VocabularyTerm",
  "type": "object"
}
