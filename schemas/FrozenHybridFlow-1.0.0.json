{
  "$defs": {
    "BatchBudget": {
      "additionalProperties": false,
      "properties": {
        "max_in_flight": {
          "default": 4,
          "maximum": 16,
          "minimum": 1,
          "title": "Max In Flight",
          "type": "integer"
        },
        "max_jobs": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Jobs",
          "type": "integer"
        },
        "max_total_samples": {
          "default": 1000000,
          "maximum": 2000000,
          "minimum": 2,
          "title": "Max Total Samples",
          "type": "integer"
        },
        "max_total_wall_seconds": {
          "default": 14400.0,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Max Total Wall Seconds",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "BatchBudget",
      "type": "object"
    },
    "ExecutionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_samples": {
          "default": 10001,
          "maximum": 100001,
          "minimum": 2,
          "title": "Max Samples",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "wall_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "title": "ExecutionBudget",
      "type": "object"
    },
    "FrozenFlowNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunManifest"
            },
            {
              "$ref": "#/$defs/NativeRunManifest"
            }
          ],
          "title": "Manifest"
        },
        "native_interface": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeInterfaceSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "manifest",
        "native_interface"
      ],
      "title": "FrozenFlowNode",
      "type": "object"
    },
    "HybridFlowBinding": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_node": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Source Node",
          "type": "string"
        },
        "source_port": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Source Port",
          "type": "string"
        },
        "target_node": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Target Node",
          "type": "string"
        },
        "target_parameter": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Parameter"
        },
        "target_port": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Target Port",
          "type": "string"
        }
      },
      "required": [
        "source_node",
        "source_port",
        "target_node",
        "target_port",
        "evidence"
      ],
      "title": "HybridFlowBinding",
      "type": "object"
    },
    "HybridFlowNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "native_interface": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimulationPlan"
            },
            {
              "$ref": "#/$defs/NativeRunSpec"
            }
          ],
          "title": "Plan"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "plan"
      ],
      "title": "HybridFlowNode",
      "type": "object"
    },
    "HybridFlowSpec": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HybridFlowBinding"
          },
          "maxItems": 32,
          "title": "Bindings",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/BatchBudget",
          "default": {
            "max_in_flight": 4,
            "max_jobs": 64,
            "max_total_samples": 1000000,
            "max_total_wall_seconds": 14400.0,
            "schema_version": "1.0.0"
          }
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/HybridFlowNode"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "nodes",
        "limitations"
      ],
      "title": "HybridFlowSpec",
      "type": "object"
    },
    "Intervention": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/Quantity"
        },
        "kind": {
          "const": "parameter_set",
          "default": "parameter_set",
          "title": "Kind",
          "type": "string"
        },
        "parameter": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Parameter",
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "at",
        "parameter",
        "quantity"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "ModelPackage": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/ScientificContext"
        },
        "dependencies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "engine": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Engine",
          "type": "string"
        },
        "engine_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Engine Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "license": {
          "maxLength": 100,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          },
          "title": "Parameters",
          "type": "array"
        },
        "ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScientificPort"
          },
          "title": "Ports",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "validity": {
          "$ref": "#/$defs/ValidityProfile"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "engine",
        "engine_version",
        "license",
        "source",
        "source_digest",
        "capabilities",
        "context",
        "validity",
        "parameters"
      ],
      "title": "ModelPackage",
      "type": "object"
    },
    "NativeExecutionProfile": {
      "additionalProperties": false,
      "properties": {
        "driver_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Driver Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "copasi_sbml",
            "osp_pkml"
          ],
          "title": "Kind",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "runtime": {
          "$ref": "#/$defs/Reference"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "runtime",
        "driver_digest",
        "limitations"
      ],
      "title": "NativeExecutionProfile",
      "type": "object"
    },
    "NativeInterfaceSpec": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/Reference"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/NativeModelPort"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Ports",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "model",
        "ports",
        "evidence",
        "limitations"
      ],
      "title": "NativeInterfaceSpec",
      "type": "object"
    },
    "NativeModelInspection": {
      "additionalProperties": false,
      "properties": {
        "compartment_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Compartment Units",
          "type": "object"
        },
        "model_time_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Time Unit"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "parameter_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Parameter Units",
          "type": "object"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Species Units",
          "type": "object"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "root",
        "namespace"
      ],
      "title": "NativeModelInspection",
      "type": "object"
    },
    "NativeModelPackage": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "inspection": {
          "$ref": "#/$defs/NativeModelInspection"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_validity": {
          "const": "not_established",
          "default": "not_established",
          "title": "Scientific Validity",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/NativeModelSpec"
        }
      },
      "required": [
        "spec",
        "content_digest",
        "inspection"
      ],
      "title": "NativeModelPackage",
      "type": "object"
    },
    "NativeModelPort": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "native_output",
            "sbml_initial_concentration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "port": {
          "$ref": "#/$defs/ScientificPort"
        },
        "quantity_key": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity Key"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Species Id"
        }
      },
      "required": [
        "port",
        "kind"
      ],
      "title": "NativeModelPort",
      "type": "object"
    },
    "NativeModelSpec": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ScientificContext"
        },
        "format": {
          "enum": [
            "sbml",
            "pkml"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "license": {
          "maxLength": 500,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "format",
        "context",
        "license",
        "source",
        "limitations"
      ],
      "title": "NativeModelSpec",
      "type": "object"
    },
    "NativeRunManifest": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "model_snapshot": {
          "$ref": "#/$defs/NativeModelPackage"
        },
        "plan": {
          "$ref": "#/$defs/NativeRunSpec"
        },
        "profile_snapshot": {
          "$ref": "#/$defs/NativeExecutionProfile"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "runtime_snapshot": {
          "$ref": "#/$defs/NativeRuntimeEvidence"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "plan",
        "model_snapshot",
        "profile_snapshot",
        "runtime_snapshot"
      ],
      "title": "NativeRunManifest",
      "type": "object"
    },
    "NativeRunSpec": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intervals": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intervals"
        },
        "model": {
          "$ref": "#/$defs/Reference"
        },
        "profile": {
          "$ref": "#/$defs/Reference"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "wall_seconds": {
          "default": 180.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "model",
        "profile"
      ],
      "title": "NativeRunSpec",
      "type": "object"
    },
    "NativeRuntimeEvidence": {
      "additionalProperties": false,
      "description": "An operator's retained execution evidence; never an executable API request.",
      "properties": {
        "artifact_digests": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxProperties": 2000,
          "minProperties": 1,
          "title": "Artifact Digests",
          "type": "object"
        },
        "engine": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Engine",
          "type": "string"
        },
        "execution_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Execution Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "managed_queue_supported": {
          "const": false,
          "default": false,
          "title": "Managed Queue Supported",
          "type": "boolean"
        },
        "profile": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Profile",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_validity": {
          "const": "not_established",
          "default": "not_established",
          "title": "Scientific Validity",
          "type": "string"
        },
        "scope": {
          "const": "operator_native_probe",
          "default": "operator_native_probe",
          "title": "Scope",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
