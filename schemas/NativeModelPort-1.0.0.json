{
  "$defs": {
    "ScientificPort": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Name",
          "type": "string"
        },
        "ownership": {
          "default": "read",
          "enum": [
            "read",
            "write"
          ],
          "title": "Ownership",
          "type": "string"
        },
        "scale": {
          "enum": [
            "molecular",
            "cellular",
            "tissue",
            "organ",
            "organism",
            "population"
          ],
          "title": "Scale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_id": {
          "title": "Semantic Id",
          "type": "string"
        },
        "shape": {
          "default": "scalar",
          "enum": [
            "scalar",
            "field",
            "agents"
          ],
          "title": "Shape",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "direction",
        "unit",
        "semantic_id",
        "scale"
      ],
      "title": "ScientificPort",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:NativeModelPort:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "native_output",
        "sbml_initial_concentration"
      ],
      "title": "Kind",
      "type": "string"
    },
    "port": {
      "$ref": "#/$defs/ScientificPort"
    },
    "quantity_key": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity Key"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "species_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Species Id"
    }
  },
  "required": [
    "port",
    "kind"
  ],
  "title": "NativeModelPort",
  "type": "object"
}
