{
  "$defs": {
    "MolecularStateFrameSpec": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ScientificContext"
        },
        "evidence": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "instance_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Instance Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "network": {
          "$ref": "#/$defs/Reference"
        },
        "origin": {
          "enum": [
            "synthetic",
            "experimental",
            "model_output"
          ],
          "title": "Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/Quantity"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/MolecularStateValue"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "network",
        "instance_id",
        "context",
        "time",
        "origin",
        "values",
        "evidence",
        "limitations"
      ],
      "title": "MolecularStateFrameSpec",
      "type": "object"
    },
    "MolecularStateValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "amount",
            "concentration",
            "count"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "quantity",
        "kind"
      ],
      "title": "MolecularStateValue",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    },
    "ScientificContext": {
      "additionalProperties": false,
      "properties": {
        "biological_system": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Biological System",
          "type": "string"
        },
        "conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Species",
          "type": "string"
        }
      },
      "required": [
        "species",
        "biological_system"
      ],
      "title": "ScientificContext",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:MolecularStateFrame:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "const": "unreviewed_declaration",
      "default": "unreviewed_declaration",
      "title": "Approval",
      "type": "string"
    },
    "network_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Network Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/MolecularStateFrameSpec"
    }
  },
  "required": [
    "spec",
    "network_digest"
  ],
  "title": "MolecularStateFrame",
  "type": "object"
}
