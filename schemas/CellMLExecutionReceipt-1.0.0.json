{
  "$defs": {
    "CellMLRunControls": {
      "additionalProperties": false,
      "properties": {
        "absolute_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "minimum": 1e-14,
          "title": "Absolute Tolerance",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "intervals": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Intervals",
          "type": "integer"
        },
        "max_step": {
          "exclusiveMinimum": 0,
          "title": "Max Step",
          "type": "number"
        },
        "method": {
          "default": "RK45",
          "enum": [
            "RK45",
            "Radau",
            "BDF"
          ],
          "title": "Method",
          "type": "string"
        },
        "relative_tolerance": {
          "default": 1e-08,
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "minimum": 1e-12,
          "title": "Relative Tolerance",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "default": 0.0,
          "title": "Start",
          "type": "number"
        },
        "time_unit": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Time Unit",
          "type": "string"
        }
      },
      "required": [
        "end",
        "time_unit",
        "max_step"
      ],
      "title": "CellMLRunControls",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:CellMLExecutionReceipt:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxProperties": 8,
      "minProperties": 3,
      "title": "Artifacts",
      "type": "object"
    },
    "controls": {
      "$ref": "#/$defs/CellMLRunControls"
    },
    "driver_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Driver Digest",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "managed_queue_supported": {
      "const": false,
      "default": false,
      "title": "Managed Queue Supported",
      "type": "boolean"
    },
    "model": {
      "$ref": "#/$defs/Reference"
    },
    "model_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Model Digest",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/Reference"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_validity": {
      "const": "not_established",
      "default": "not_established",
      "title": "Scientific Validity",
      "type": "string"
    },
    "scope": {
      "const": "operator_cellml_execution",
      "default": "operator_cellml_execution",
      "title": "Scope",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "model",
    "model_digest",
    "runtime",
    "image_digest",
    "driver_digest",
    "controls",
    "artifacts",
    "limitations"
  ],
  "title": "CellMLExecutionReceipt",
  "type": "object"
}
