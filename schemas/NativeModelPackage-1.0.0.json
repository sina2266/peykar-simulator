{
  "$defs": {
    "NativeModelInspection": {
      "additionalProperties": false,
      "properties": {
        "compartment_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Compartment Units",
          "type": "object"
        },
        "model_time_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Time Unit"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "parameter_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Parameter Units",
          "type": "object"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Species Units",
          "type": "object"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "root",
        "namespace"
      ],
      "title": "NativeModelInspection",
      "type": "object"
    },
    "NativeModelSpec": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ScientificContext"
        },
        "format": {
          "enum": [
            "sbml",
            "pkml"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "license": {
          "maxLength": 500,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "format",
        "context",
        "license",
        "source",
        "limitations"
      ],
      "title": "NativeModelSpec",
      "type": "object"
    },
    "ScientificContext": {
      "additionalProperties": false,
      "properties": {
        "biological_system": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Biological System",
          "type": "string"
        },
        "conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Species",
          "type": "string"
        }
      },
      "required": [
        "species",
        "biological_system"
      ],
      "title": "ScientificContext",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:NativeModelPackage:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "inspection": {
      "$ref": "#/$defs/NativeModelInspection"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_validity": {
      "const": "not_established",
      "default": "not_established",
      "title": "Scientific Validity",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/NativeModelSpec"
    }
  },
  "required": [
    "spec",
    "content_digest",
    "inspection"
  ],
  "title": "NativeModelPackage",
  "type": "object"
}
