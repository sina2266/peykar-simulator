{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:VocabularyMappingConflict:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Mappings",
      "type": "array"
    },
    "reason": {
      "const": "competing_exact_mappings",
      "default": "competing_exact_mappings",
      "title": "Reason",
      "type": "string"
    },
    "resolution": {
      "const": "unreviewed",
      "default": "unreviewed",
      "title": "Resolution",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "mappings"
  ],
  "title": "VocabularyMappingConflict",
  "type": "object"
}
