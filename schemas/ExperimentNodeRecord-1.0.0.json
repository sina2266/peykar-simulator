{
  "$id": "urn:peykar:schema:ExperimentNodeRecord:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "node_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Node Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "node_id",
    "status"
  ],
  "title": "ExperimentNodeRecord",
  "type": "object"
}
