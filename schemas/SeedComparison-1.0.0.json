{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:SeedComparison:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/Reference"
    },
    "candidate_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "candidate_lineage_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Lineage Digest",
      "type": "string"
    },
    "max_absolute_error": {
      "minimum": 0,
      "title": "Max Absolute Error",
      "type": "number"
    },
    "n": {
      "maximum": 100001,
      "minimum": 2,
      "title": "N",
      "type": "integer"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "reference": {
      "$ref": "#/$defs/Reference"
    },
    "rmse": {
      "minimum": 0,
      "title": "Rmse",
      "type": "number"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    }
  },
  "required": [
    "seed",
    "reference",
    "candidate",
    "candidate_digest",
    "candidate_lineage_digest",
    "n",
    "rmse",
    "max_absolute_error",
    "passed"
  ],
  "title": "SeedComparison",
  "type": "object"
}
