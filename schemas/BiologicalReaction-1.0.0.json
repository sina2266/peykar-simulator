{
  "$defs": {
    "ProcessModifier": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity"
        },
        "role": {
          "enum": [
            "catalyst",
            "positive_regulator",
            "negative_regulator",
            "regulator"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "role"
      ],
      "title": "ProcessModifier",
      "type": "object"
    },
    "ProcessSourceRelation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "predicate": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Predicate",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "predicate",
        "target",
        "label"
      ],
      "title": "ProcessSourceRelation",
      "type": "object"
    },
    "StoichiometricTerm": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "default": 1,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Numerator",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "State Id",
          "type": "string"
        }
      },
      "required": [
        "state_id"
      ],
      "title": "StoichiometricTerm",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:BiologicalReaction:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "external_id": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "External Id",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "inferred": {
      "title": "Inferred",
      "type": "boolean"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/StoichiometricTerm"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "label": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Label",
      "type": "string"
    },
    "modifiers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProcessModifier"
      },
      "maxItems": 100,
      "title": "Modifiers",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/StoichiometricTerm"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Outputs",
      "type": "array"
    },
    "reversible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reversible"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_class": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source Class",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Source Id",
      "type": "string"
    },
    "unexpanded_relations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProcessSourceRelation"
      },
      "maxItems": 200,
      "title": "Unexpanded Relations",
      "type": "array"
    }
  },
  "required": [
    "id",
    "label",
    "source_id",
    "external_id",
    "source_class",
    "inferred",
    "inputs",
    "outputs",
    "evidence"
  ],
  "title": "BiologicalReaction",
  "type": "object"
}
