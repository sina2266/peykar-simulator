{
  "$defs": {
    "FlowNodeRecord": {
      "additionalProperties": false,
      "properties": {
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manifest Digest"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Node Id",
          "type": "string"
        },
        "queue": {
          "enum": [
            "reference",
            "native"
          ],
          "title": "Queue",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "skipped",
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "transfer_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transfer Digest"
        }
      },
      "required": [
        "node_id",
        "queue",
        "run_id",
        "manifest_digest",
        "transfer_digest",
        "derivation",
        "status"
      ],
      "title": "FlowNodeRecord",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "$id": "urn:peykar:schema:HybridFlowRunRecord:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cancel_requested": {
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "flow": {
      "$ref": "#/$defs/Reference"
    },
    "flow_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Flow Digest",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/FlowNodeRecord"
      },
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "flow",
    "flow_digest",
    "status",
    "cancel_requested",
    "error",
    "created_at",
    "updated_at",
    "nodes"
  ],
  "title": "HybridFlowRunRecord",
  "type": "object"
}
