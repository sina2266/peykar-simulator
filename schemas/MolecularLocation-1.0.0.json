{
  "$id": "urn:peykar:schema:MolecularLocation:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 200,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9_.-]+$",
      "title": "Id",
      "type": "string"
    },
    "label": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Label",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "label"
  ],
  "title": "MolecularLocation",
  "type": "object"
}
