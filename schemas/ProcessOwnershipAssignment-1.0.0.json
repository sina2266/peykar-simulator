{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:ProcessOwnershipAssignment:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/Reference"
    },
    "model_kind": {
      "enum": [
        "reference",
        "native",
        "cellml"
      ],
      "title": "Model Kind",
      "type": "string"
    },
    "owner_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Owner Id",
      "type": "string"
    },
    "rationale": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Rationale",
      "type": "string"
    },
    "reaction_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
        "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Reaction Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "model_kind",
    "model",
    "reaction_ids",
    "rationale",
    "evidence"
  ],
  "title": "ProcessOwnershipAssignment",
  "type": "object"
}
