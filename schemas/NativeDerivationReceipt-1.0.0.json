{
  "$defs": {
    "FlowTransfer": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_manifest_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Manifest Digest",
          "type": "string"
        },
        "source_node": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Source Node",
          "type": "string"
        },
        "source_port": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Source Port",
          "type": "string"
        },
        "source_quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "source_result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Result Digest",
          "type": "string"
        },
        "source_run_id": {
          "title": "Source Run Id",
          "type": "string"
        },
        "target_port": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Target Port",
          "type": "string"
        },
        "target_quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "target_selector": {
          "title": "Target Selector",
          "type": "string"
        }
      },
      "required": [
        "source_node",
        "source_run_id",
        "source_manifest_digest",
        "source_result_digest",
        "source_port",
        "target_port",
        "target_selector",
        "source_quantity",
        "target_quantity",
        "evidence"
      ],
      "title": "FlowTransfer",
      "type": "object"
    },
    "NativeInterfaceSpec": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/Reference"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/NativeModelPort"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Ports",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "model",
        "ports",
        "evidence",
        "limitations"
      ],
      "title": "NativeInterfaceSpec",
      "type": "object"
    },
    "NativeModelInspection": {
      "additionalProperties": false,
      "properties": {
        "compartment_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Compartment Units",
          "type": "object"
        },
        "model_time_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Time Unit"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "parameter_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Parameter Units",
          "type": "object"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species_units": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Species Units",
          "type": "object"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "root",
        "namespace"
      ],
      "title": "NativeModelInspection",
      "type": "object"
    },
    "NativeModelPackage": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "inspection": {
          "$ref": "#/$defs/NativeModelInspection"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_validity": {
          "const": "not_established",
          "default": "not_established",
          "title": "Scientific Validity",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/NativeModelSpec"
        }
      },
      "required": [
        "spec",
        "content_digest",
        "inspection"
      ],
      "title": "NativeModelPackage",
      "type": "object"
    },
    "NativeModelPort": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "native_output",
            "sbml_initial_concentration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "port": {
          "$ref": "#/$defs/ScientificPort"
        },
        "quantity_key": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity Key"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Species Id"
        }
      },
      "required": [
        "port",
        "kind"
      ],
      "title": "NativeModelPort",
      "type": "object"
    },
    "NativeModelSpec": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/ScientificContext"
        },
        "format": {
          "enum": [
            "sbml",
            "pkml"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "license": {
          "maxLength": 500,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "format",
        "context",
        "license",
        "source",
        "limitations"
      ],
      "title": "NativeModelSpec",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    },
    "ScientificContext": {
      "additionalProperties": false,
      "properties": {
        "biological_system": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Biological System",
          "type": "string"
        },
        "conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "species": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Species",
          "type": "string"
        }
      },
      "required": [
        "species",
        "biological_system"
      ],
      "title": "ScientificContext",
      "type": "object"
    },
    "ScientificPort": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
          "title": "Name",
          "type": "string"
        },
        "ownership": {
          "default": "read",
          "enum": [
            "read",
            "write"
          ],
          "title": "Ownership",
          "type": "string"
        },
        "scale": {
          "enum": [
            "molecular",
            "cellular",
            "tissue",
            "organ",
            "organism",
            "population"
          ],
          "title": "Scale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_id": {
          "title": "Semantic Id",
          "type": "string"
        },
        "shape": {
          "default": "scalar",
          "enum": [
            "scalar",
            "field",
            "agents"
          ],
          "title": "Shape",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "direction",
        "unit",
        "semantic_id",
        "scale"
      ],
      "title": "ScientificPort",
      "type": "object"
    }
  },
  "$id": "urn:peykar:schema:NativeDerivationReceipt:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "child_content_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Child Content Digest",
      "type": "string"
    },
    "interface": {
      "$ref": "#/$defs/NativeInterfaceSpec"
    },
    "parent": {
      "$ref": "#/$defs/NativeModelPackage"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "transfers": {
      "items": {
        "$ref": "#/$defs/FlowTransfer"
      },
      "title": "Transfers",
      "type": "array"
    },
    "transformer": {
      "const": "sbml.initial_concentration.1.0.0",
      "default": "sbml.initial_concentration.1.0.0",
      "title": "Transformer",
      "type": "string"
    }
  },
  "required": [
    "parent",
    "interface",
    "transfers",
    "child_content_digest"
  ],
  "title": "NativeDerivationReceipt",
  "type": "object"
}
