{
  "$id": "urn:peykar:schema:LibrarySourceSpec:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Commit",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
      "title": "Id",
      "type": "string"
    },
    "license": {
      "maxLength": 200,
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "license_files": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "License Files",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "repository": {
      "pattern": "^https://github.com/[\\w.-]+/[\\w.-]+$",
      "title": "Repository",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "repository",
    "commit",
    "license",
    "license_files",
    "capabilities",
    "limitations"
  ],
  "title": "LibrarySourceSpec",
  "type": "object"
}
