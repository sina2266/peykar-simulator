{
  "name": "@peykar/workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "LicenseRef-Peykar-Noncommercial-1.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "types": "openapi-typescript ../../schemas/openapi.json -o src/generated/api.d.ts",
    "check:types": "openapi-typescript ../../schemas/openapi.json -o src/generated/api.d.ts --check",
    "check": "prettier --check src vite.config.ts build-notices.mjs index.html && tsc --noEmit && vitest run && npm run check:types",
    "build": "tsc --noEmit && vite build && node build-notices.mjs",
    "format": "prettier --write src vite.config.ts build-notices.mjs index.html"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
